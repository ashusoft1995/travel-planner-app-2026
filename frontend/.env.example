# Optional: override API origin (defaults in code to http://127.0.0.1:5000).
# Use this when the API is not on the same machine or port, e.g. production:
# NEXT_PUBLIC_API_URL=https://your-api.example.com

# Next.js rewrites /api/* (used if you rely on same-origin /api; optional for local dev).
# BACKEND_URL=http://127.0.0.1:5000

# SSR-only override (optional)
# INTERNAL_API_URL=http://127.0.0.1:5000
